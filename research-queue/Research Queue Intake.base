filters:
  and:
    - file.inFolder("research-queue/cards")
    - note.kind == "research-card"
    - or:
        - note.status == "Ready"
        - note.status == "Blocked"
views:
  - type: kanban
    name: Ready and Blocked Intake
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - input_ticker
      - instrument_type
      - workflow
      - updated_at
      - result_code
