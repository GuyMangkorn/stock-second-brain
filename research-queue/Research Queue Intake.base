filters:
  and:
    - file.inFolder("research-queue/cards")
    - note.kind == "research-card"
    - or:
        - note.status == "Ready"
        - note.status == "Blocked"
views:
  - type: kanban
    name: Ready and Blocked Intake
    groupBy:
      property: note.status
      direction: ASC
    order:
      - file.name
      - note.status
      - note.input_ticker
      - note.instrument_type
      - note.workflow
      - note.updated_at
      - note.result_code
