filters:
  and:
    - file.inFolder("research-queue/cards")
    - note.kind == "research-card"
views:
  - type: table
    name: Research Queue Monitor
    order:
      - status
      - created_at
      - card_id
      - file.name
      - input_ticker
      - instrument_type
      - workflow
      - batch_id
      - claim_owner
      - lease_expires_at
      - execution_phase
      - result_code
      - output_paths
      - completed_at
      - commit_id
