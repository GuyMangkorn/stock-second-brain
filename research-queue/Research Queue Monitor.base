filters:
  and:
    - file.inFolder("research-queue/cards")
    - note.kind == "research-card"
views:
  - type: table
    name: Research Queue Monitor
    order:
      - note.status
      - note.created_at
      - note.card_id
      - file.name
      - note.input_ticker
      - note.instrument_type
      - note.workflow
      - note.batch_id
      - note.claim_owner
      - note.lease_expires_at
      - note.execution_phase
      - note.result_code
      - note.output_paths
      - note.completed_at
      - note.commit_id
